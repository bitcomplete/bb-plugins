{
  "name": "bb-plugin-stewards",
  "version": "0.1.0",
  "type": "module",
  "description": "Long-lived threads that manage a labelled Linear ticket or GitHub pull request, or review a teammate's pull request, until it is done",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Stewards",
    "description": "Give each labelled Linear ticket or GitHub pull request, and each teammate's pull request, a long-lived thread that manages it as you, by a playbook kept in the project's .bb.",
    "branding": {
      "icon": "ShieldCheck"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bb plugin build"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.2",
    "hono": "^4.11.9",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
