  "description": "Drive bb with the keys of tmux: stock tmux bindings with your own tmux config on top.",
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build"
