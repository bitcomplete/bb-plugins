{
  "name": "bb-plugin-github",
  "version": "0.1.0",
  "type": "module",
  "description": "Let a thread watch a GitHub pull request or issue and be woken when it changes",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "GitHub",
    "description": "Threads watch a pull request or issue with the gh login on this server and are messaged when reviews, comments, checks or state change.",
    "branding": {
      "icon": "GitPullRequest"
    },
    "server": "./server.ts",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bb plugin build"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.2",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
